{
  "info": {
    "name": "StockReserve",
    "description": "API local em memória. Preencha adminPassword. Execute Fluxo principal em ordem em uma aplicação recém-iniciada. Para cadastrar e autenticar o operador, preencha operadorPassword com 12 a 64 caracteres. Login salva o token automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@local.test",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "operadorPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "produtoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pedidoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pedidoCancelarId",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Fluxo principal",
      "item": [
        {
          "name": "01 - Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Cadastrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente de exemplo\",\n  \"email\": \"cliente@exemplo.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"clienteId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Cadastrar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/produtos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"TEC-001\",\n  \"nome\": \"Teclado\",\n  \"descricao\": \"Teclado USB\",\n  \"precoAtual\": 100.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"produtoId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Registrar 5 unidades",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/estoque/entradas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Reservar 2 unidades",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"pedidoId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Estoque: 5 físicas, 2 reservadas, 3 disponíveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/estoque/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"saldoFisico = 5\", function () { pm.expect(pm.response.json().saldoFisico).to.eql(5); });",
                  "pm.test(\"reservado = 2\", function () { pm.expect(pm.response.json().reservado).to.eql(2); });",
                  "pm.test(\"disponivel = 3\", function () { pm.expect(pm.response.json().disponivel).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Confirmar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Estoque: 3 físicas, 0 reservadas, 3 disponíveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/estoque/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"saldoFisico = 3\", function () { pm.expect(pm.response.json().saldoFisico).to.eql(3); });",
                  "pm.test(\"reservado = 0\", function () { pm.expect(pm.response.json().reservado).to.eql(0); });",
                  "pm.test(\"disponivel = 3\", function () { pm.expect(pm.response.json().disponivel).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Reservar mais 1 unidade",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"pedidoCancelarId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Cancelar segundo pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoCancelarId}}/cancelar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Estoque final: 3 disponíveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/estoque/{{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"saldoFisico = 3\", function () { pm.expect(pm.response.json().saldoFisico).to.eql(3); });",
                  "pm.test(\"reservado = 0\", function () { pm.expect(pm.response.json().reservado).to.eql(0); });",
                  "pm.test(\"disponivel = 3\", function () { pm.expect(pm.response.json().disponivel).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Histórico de movimentações",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/estoque/movimentacoes?produtoId={{produtoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
